# Set a LAN address to make Atlas available on your private network.
ATLAS_BIND=127.0.0.1
ATLAS_PORT=8097

# Isolated add-in execution. Set this to the actual absolute checkout path.
ATLAS_WORKER_HOST_QUEUE=/absolute/path/to/atlas/worker-jobs
# Private Docker-network callback; no public port is needed for worker imports.
ATLAS_CONNECTOR_CALLBACK_URL=http://atlas-connector-callback:8765
# Optional explicit worker network CIDR; the runner also reports its Docker subnet.
ATLAS_WORKER_SUBNETS=

# Obtain with: stat -c %g /var/run/docker.sock on the Docker host.
ATLAS_DOCKER_GID=998
